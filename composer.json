{
    "name": "vimatech/laravel-secure-fields",
    "description": "Secure encrypted Eloquent model fields for sensitive data in Laravel applications.",
    "keywords": [
        "laravel",
        "encryption",
        "eloquent",
        "security",
        "aes-256-gcm",
        "encrypted-fields",
        "gdpr",
        "pii"
    ],
    "homepage": "https://github.com/vimatech-io/laravel-secure-fields",
    "license": "MIT",
    "authors": [
        {
            "name": "Adel Zemzemi",
            "email": "hello@adelzemzemi.dev",
            "homepage": "https://vimatech.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/encryption": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "VimaTech\\SecureFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VimaTech\\SecureFields\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "echo 'Package ready'",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VimaTech\\SecureFields\\Providers\\SecureFieldsServiceProvider"
            ],
            "aliases": {
                "SecureFields": "VimaTech\\SecureFields\\Facades\\SecureFields"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
